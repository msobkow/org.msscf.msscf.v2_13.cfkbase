<RuleSet
		xmlns="http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xsi:schemaLocation="http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd"
	ToolSet="java+javafx"
	Name=".gitignore"
	Revision="2.13"
	Descr="Java 25 JavaFX Project .gitignore">

	<GenFile GenDef="SchemaDef" Name="fileSchemaJavaFXGitIgnore"
		GenerateOnce="false"
		ModuleName="$reference ManufacturingSchema lower JavaPackage$"
		SourceBundle="java"
		BasePackageName="$reference ManufacturingSchema lower JavaPackageName$/$reference ManufacturingSchema lower SchemaName$-javafx"
		SubPackageName=""
		ExpansionClassName="JavaFXDotGitIgnore"
		ExpansionKeyName="$SchemaName$JavaFXDotGitIgnore"
		ExpansionFileName=".gitignore"
>marktemp
# Temp files
installer
*.swp
*~
.metadata
RemoteSystemsTempFiles
# Netbeans configuration
Servers

# Compiled class file
*.class

# Build directory
build
/target/

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
</GenFile>

</RuleSet>
