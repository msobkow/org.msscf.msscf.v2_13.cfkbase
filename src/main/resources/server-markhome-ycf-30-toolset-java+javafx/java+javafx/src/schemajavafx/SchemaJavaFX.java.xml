<RuleSet
		xmlns="http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xsi:schemaLocation="http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd"
	ToolSet="java+javafx"
	Name="src/schemajavafx/SchemaJavaFX.java"
	Revision="3.0"
	Descr="Java 25 JavaFX Library Hooks">

	<GenFile GenDef="SchemaDef" Name="fileSchemaJavaFXJava"
		GenerateOnce="false"
		ModuleName="$reference ManufacturingSchema lower JavaPackage$"
		SourceBundle="java"
		BasePackageName="$reference ManufacturingSchema lower JavaPackageName$/$reference ManufacturingSchema lower SchemaName$-javafx/src/main/java"
		SubPackageName="$reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower SchemaName$javafx"
		ExpansionClassName="$SchemaName$JavaFXJava"
		ExpansionKeyName="$SchemaName$JavaFXJava"
		ExpansionFileName="$SchemaName$JavaFX.java"
>// Description: Java 25 JavaFX package hook for $SchemaName$.

$MssSourceLicense$

package $lower DefTopProjectName$.$DefVUnderVersion$.$lower DefSubProjectName$.$lower DefSchemaName$javafx;

import server.markhome.ycf.*;
import server.markhome.ycf.dbutil.*;
import server.markhome.ycf.Inz;
import server.markhome.ycf.InzPathEntry;
import server.markhome.ycf.javafx.*;

/**
 *	The $SchemaName$JavaFX package hook is used to initialize the Inz path search among other things.
 */
public class $SchemaName$JavaFX
{
	protected static boolean initialized = false;
		
	public static void init() {
		if (initialized) {
			return;
		}
		YCFJavaFX.init();
		initialized = true;
        <!--Inz.addPathEntry(new InzPathEntry("/opt/ycf/v3_1/java" + "/server.markhome.ycf.ycflibjavafx/src/main/resources/inz/langs"));-->
		InzPathEntry entry = new InzPathEntry($SchemaName$JavaFX.class, "resource:/inz/langs/");
		Inz.addPathEntry(entry);
	}
}
</GenFile>

</RuleSet>
