		BasePackageName="$popto Tld lower Name$.$popto TopDomain lower Name$.$popto TopProject lower Name$$/$popto TopProject lower Name$-$lower MfgVUnderVersion$/$popto TopProject lower Name$-$lower MfgVUnderVersion$-$reference ManufacturingSchema lower SchemaName$-ramtest/src/main/resources"
