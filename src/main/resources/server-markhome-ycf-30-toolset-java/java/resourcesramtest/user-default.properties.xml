		ExpansionClassName="$SchemaName$RamTestUserDefaultProperties"
		ExpansionKeyName="$SchemaName$RamTestUserDefaultProperties"
		ExpansionFileName="user-default.properties"
>#user-default.properties for $SchemaName$RamTest$declUserDefaultPropertiesUserSettings$$iterate SchemaRefs( each declUserDefaultPropertiesDbSettings empty empty)$$declUserDefaultPropertiesDbSettings$</GenFile>

