<RuleSet
	xmlns="http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd http://ycf.markhome.server/mssycf/2.0.13/xsd/ycfgenkb-2.13-ruleset.xsd"
	ToolSet="java"
	Name="src/schemapubobj/ISchemaPubSchemaObj.java"
	Revision="3.0"
	Descr="Java 25 Public Schema Object interface">

	<GenFile GenDef="SchemaDef" Name="fileISchemaPubSchemaObjJava"
		GenerateOnce="false"
		ModuleName="$reference ManufacturingSchema lower JavaPackageName$"
		SourceBundle="java"
		BasePackageName="$reference ManufacturingSchema lower JavaPackageName$/$reference ManufacturingSchema lower JavaPackageName$-$reference ManufacturingSchema lower SchemaName$-pub/src/main/java"
		SubPackageName="$reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower DefPubSchemaName$obj"
		ExpansionClassName="I$DefPubSchemaName$SchemaObjJava"
		ExpansionKeyName="I$DefPubSchemaName$SchemaObjJava"
		ExpansionFileName="I$DefPubSchemaName$SchemaObj.java"
>// Description: Java 25 Public Schema Object interface for $DefPubSchemaName$.

$MssSourceLicense$

package $reference ManufacturingSchema lower JavaPackage$.$reference ManufacturingSchema lower DefPubSchemaName$obj;

import java.math.*;
import java.sql.*;
import java.text.*;
import java.time.*;
import java.util.*;
import org.apache.commons.codec.binaryYCFCore64;
import org.apache.commons.text.StringEscapeUtils;
import server.markhome.ycf.*;
import server.markhome.ycf.dbutil.*;
$poptop SchemaDef iterate SchemaRefs( each importJavaPubPackageSchemaName empty empty )$$importJavaPubPackageSchemaName$$poptop SchemaDef iterate SchemaRefs( each importJavaPubPackageSchemaNameObj empty empty )$$schematweak CafePubSchemaObjImport$$schematweak CafeReferencedPubSchemaObjImport$

public interface I$PubSchemaName$SchemaObj$iterate SchemaRefs( first extendPubISchemaSchemaObj each commaPubNewlineISchemaSchemaObj empty empty )$
{$iterate SchemaRefs( each empty empty declPubISchemaSchemaObj )$$iterate SchemaRefs( each declPubISchemaSchemaObjBSAccessors empty empty )$$declPubISchemaSchemaObjBSAccessors$$iterate SchemaPublicTables( each declPubISchemaSchemaObjTableObjAccessors empty empty )$$JavaSchemaObjInterface$$PubReferencedJavaSchemaObjInterface$}
</GenFile>

	<GenRule GenDef="SchemaRef" Name="declPubISchemaSchemaObjBSAccessors">$reference RefSchema declPubISchemaSchemaObjBSAccessors$</GenRule>
	<GenRule GenDef="SchemaDef" Name="declPubISchemaSchemaObjBSAccessors">
	public I$PubSchemaName$Schema get$DefPubSchemaName$BackingStore();
	public void set$DefPubSchemaName$BackingStore(I$PubSchemaName$Schema $lower DefPubSchemaName$BackingStore);
</GenRule>

	<GenRule GenDef="SchemaRef" Name="extendPubISchemaSchemaObj">
	extends I$reference RefSchema PubSchemaName$SchemaObj</GenRule>

	<GenRule GenDef="SchemaRef" Name="commaPubNewlineISchemaSchemaObj">,
		I$reference RefSchema PubSchemaName$SchemaObj</GenRule>

	<GenRule GenDef="Object" Name="declPubISchemaSchemaObj">
	I$SecPubSchemaName$Authorization getAuthorization();
	void setAuthorization( I$SecPubSchemaName$Authorization value );

	String getSchemaName();

	void setSecClusterName( String value );
	I$SecPubSchemaName$ClusterObj getSecCluster();
	void setSecCluster( I$SecPubSchemaName$ClusterObj value );

	void setSecTenantName( String value );
	I$SecPubSchemaName$TenantObj getSecTenant();
	void setSecTenant( I$SecPubSchemaName$TenantObj value );

	void setSecUserName( String value );
	I$SecPubSchemaName$SecUserObj getSecUser();
	void setSecUser( I$SecPubSchemaName$SecUserObj value );

	void setSecSessionId( YCFDbKeyHash256 value );
	I$SecPubSchemaName$SecSessionObj getSecSession();
	void setSecSession( I$SecPubSchemaName$SecSessionObj value );

	void logout();

	void minimizeMemory();
</GenRule>

	<GenRule GenDef="SchemaRef" Name="extendPubSchemaSchemaObj">
	extends $reference RefSchema PubSchemaName$SchemaObj</GenRule>

	<GenRule GenDef="SchemaRef" Name="commaPubNewlineSchemaSchemaObj">,
		$reference RefSchema PubSchemaName$SchemaObj</GenRule>

	<GenRule GenDef="SchemaDef" Name="PubReferencedJavaSchemaObjInterface"
		>$iterate SchemaRefs( each ApplyPubJavaSchemaObjInterface empty empty )$</GenRule>

	<GenRule GenDef="SchemaRef" Name="ApplyPubJavaSchemaObjInterface"
		>$reference RefSchema JavaSchemaObjInterface$</GenRule>

	<GenRule GenDef="SchemaDef" Name="PubReferencedJavaSchemaObjImport"
		>$iterate SchemaRefs( each ApplyPubJavaSchemaObjImport empty empty )$</GenRule>

	<GenRule GenDef="SchemaRef" Name="ApplyPubJavaSchemaObjImport"
		>$reference RefSchema JavaSchemaObjImport$</GenRule>

	<GenRule GenDef="Object" Name="declPubISchemaSchemaObjReleasePreparedStatements">
	/**
	 *	Release any prepared statements acquired by this connection.
	 *	&lt;p&gt;
	 *	Resets the prepared statements so they can acquire the new value of
	 *	&lt;tt&gt;setDbSchemaName()&lt;/tt&gt;.
	 */
	void releasePreparedStatements();</GenRule>

	<GenRule GenDef="Object" Name="declPubISchemaSchemaObjTransactionMethods">
	/**
	 *	If a transaction is already opened for the schema connection,
	 *	return false.  If a new transaction is successfully opened,
	 *	return true.  Otherwise throw a RuntimeException detailing
	 *	why a transaction could not be initiated.
	 *
	 *	This permits the database persistence implementations to
	 *	switch between participating in an existing transaction
	 *	or implementing an implicit atomic transaction that is
	 *	committed or rolled back before the method returns:
	 *
	 *		boolean txnInitiated = false;
	 *		try {
	 *			txnInitiated = schema.beginTransaction();
	 *			... business logic and presentation code ...
	 *			if( txnInitiated ) {
	 *				schema.commit();
	 *			}
	 *		}
	 *		catch( RuntimeException e ) {
	 *			if( txnInitiated ) {
	 *				try {
	 *					schema.rollback();
	 *				}
	 *				catch( RuntimeException e ) {
	 *				}
	 *			}
	 *			... report exception or throw exception with cause ...
	 *		}
	 *
	 *	As the current web-form focused implementation will be managing
	 *	the transactions in the Servlet page response, I don't need to
	 *	implement the atomic transaction wrappers yet.
	 */
	boolean isTransactionOpen();
	boolean beginTransaction();
	void commit();
	void rollback();
</GenRule>

	<GenRule GenDef="Table" Name="declPubISchemaSchemaObjTableObjAccessors">$switch IsPublic yes reallyDeclPubISchemaSchemaObjTableObjAccessors default empty$</GenRule>
	<GenRule GenDef="Table" Name="reallyDeclPubISchemaSchemaObjTableObjAccessors"
		>$switch HasDefSchema yes empty default indubitablyPubDeclISchemaSchemaObjTableObjAccessors$</GenRule>

	<GenRule GenDef="Table" Name="indubitablyPubDeclISchemaSchemaObjTableObjAccessors">
	/**
	 *	Get the $TableName$ interface for the schema.
	 *
	 *	@return	The I$DefPubSchemaName$$TableName$TableObj interface implementation for the schema.
	 */
	I$DefPubSchemaName$$TableName$TableObj get$TableName$TableObj();
</GenRule>

</RuleSet>
