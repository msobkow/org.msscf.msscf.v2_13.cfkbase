<RuleSet
	xmlns="http://cf.markhome.server/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xsi:schemaLocation="http://cf.markhome.server/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd http://cf.markhome.server/msscf/2.0.13/xsd/cfgenkb-2.13-ruleset.xsd"
	ToolSet="java"
	Name=".gitignore"
	Revision="3.0"
	Descr="Java 25 .gitignore">

	<GenFile GenDef="SchemaDef" Name="fileSchemaJavaGitIgnore"
		GenerateOnce="false"
		ModuleName="$reference ManufacturingSchema lower JavaPackageName$"
		SourceBundle="java"
		BasePackageName="$TopProjectDomainName$/$TopProjectMfgVersion$/$SchemaProjectName$-core"
		SubPackageName=""
		ExpansionClassName="JavaDotGitIgnore"
		ExpansionKeyName="$SchemaName$JavaDotGitIgnore"
		ExpansionFileName=".gitignore"
>marktemp
# Temp files
installer
*.swp
*~
.metadata
RemoteSystemsTempFiles
# Netbeans configuration
Servers

# Compiled class file
*.class

# Build directory
build
/target/

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
</GenFile>

</RuleSet>
